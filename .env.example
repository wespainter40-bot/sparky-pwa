# Copy to .env and fill in what you have. Everything is optional.
PORT=3000

# 1) Groq (primary) - free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 2) OpenRouter (free models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3) Any other OpenAI-compatible endpoint (optional)
# CUSTOM_BASE_URL=https://example.com/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=

# 4) Pollinations needs no key and is always tried last before the local reply.
# POLLINATIONS_MODEL=openai

# Time zone used in the markdown logs. (CHILD_NAME is reserved for a possible future kid mode and is ignored today.)
TIMEZONE=America/Chicago

# Protects /api/sessions, /api/export*, /api/sync. Set this when hosting publicly!
ADMIN_TOKEN=

# Where session logs are written (default ./data/sessions)
# DATA_DIR=

# Optional Google Drive sync (see README). Use ONE of the two options.
GOOGLE_DRIVE_FOLDER_ID=
# A) service account (best with a Shared Drive): path to key file or the raw JSON
GOOGLE_SERVICE_ACCOUNT_JSON=
# B) OAuth refresh token (works with a normal My Drive folder)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
